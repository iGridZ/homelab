# Copy to .env on the host and fill in real values. .env is never committed.
# API token: Cloudflare → My Profile → API Tokens, permission "Zone → DNS → Edit",
# restricted to the zones listed below.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Comma-separated, no spaces. Only names that should point at the home IP.
DOMAINS=example.org,app.example.org
