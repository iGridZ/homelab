# Copy to .env on the host and fill in real values. .env is never committed.
# Used by vivosun-fetcher (see github.com/iGridZ/vivosun-fetcher)
VIVOSUN_EMAIL=you@example.com
VIVOSUN_PASSWORD=change-me
CAMERA_NAME_MATCH=GrowCam
CAMERA_IP=192.168.1.88
CAMERA_RTSP_PATH=/cam/realmonitor?channel=1&subtype=0
STREAM_NAME=growcam
STREAM_VIEW_USER=
STREAM_VIEW_PASS=
REFRESH_INTERVAL_SECONDS=21600
