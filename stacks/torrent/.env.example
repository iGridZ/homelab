# Copy to .env on the host, chmod 600, fill in. .env is never committed.

# ProtonVPN WireGuard private key, generated with "NAT-PMP (Port Forwarding)" enabled
PROTON_WG_PRIVATE_KEY=base64-private-key
# P2P server countries, comma-separated
PROTON_SERVER_COUNTRIES=Netherlands

# Login for the mousehole web UI (long random password)
MOUSEHOLE_AUTH_PASSWORD=change-me
